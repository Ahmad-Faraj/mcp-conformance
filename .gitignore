# Raw census working data stays local: it carries un-redacted stderr and the
# private disclosure log. The PUBLIC, disclosure-filtered release under
# data/release/ is built by driver/make_release.py and IS tracked -- the paper
# depends on it being available.
data/*
!data/summary.json
!data/release/
data/release/*
!data/release/DATASET.md
!data/release/LICENSE.txt
!data/release/probe_census.jsonl
!data/release/sdk_attribution.csv
!data/release/summary.json
# Required to reproduce the entry-point-corrected runnability figure.
!data/release/entrypoint_reprobe.jsonl
# Raw protocol exchanges; the consequences analysis is computed from these.
!data/release/transcripts.jsonl
# The registry snapshot is needed to verify the eligibility funnel (17,432 -> 6,106),
# so it ships with the release despite its size.
!data/release/frame_latest.jsonl
# The classified consequences, keyed by the same pseudonyms the census rows use,
# so the silent-execution split is recomputable from the release alone.
!data/release/consequences.json
# Repository language per malformed-frame failure, which sizes the blind spot in
# the dependency-graph SDK attribution.
!data/release/repo_languages.csv
!data/release/residual_languages.csv
# The launch-argument re-probe; the corrected headline reads it.
!data/release/args_reprobe.jsonl
# The September re-run of the same frame, and the pinning experiment that
# establishes what broke the servers it lost.
!data/release/probe_census_sept.jsonl
!data/release/pin_experiment.csv
# The blinded rating pass: labels, the training pass kept separate, and the
# codebook, so the agreement statistic can be recomputed rather than trusted.
!data/release/validation/
!data/release/validation/*
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf
# The compiled preprint is the artifact readers are pointed at, so it ships
# with the source rather than being rebuilt by each reader.
!paper/main.pdf
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
# Springer (EMSE) build. The class and .bst are Springer's, redistributed with the
# template, and the PDF is tracked so a reader can see the submitted form.
paper/emse/*.aux
paper/emse/*.log
paper/emse/*.out
paper/emse/*.bbl
paper/emse/*.blg
paper/emse/*.fls
paper/emse/*.fdb_latexmk
paper/emse/*.spl
paper/emse/build*.log
__pycache__/
*.pyc

# Private working notes, never published.
private/

# Prose checker outputs.
tools/metrics.*
tools/flags.tsv
tools/sentences.tsv
tools/ngrams.txt
tools/numbers.txt

# Submission bundles are built by tools/make_submission.py, not tracked.
dist/
